---
// Dev-only route injected by editor/integration.mjs. Never part of `astro build`.
export const prerender = false;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Editor · renacentista.dev</title>
    <!-- Charis SIL descends from Charter (Medium's body face) and Inter stands in
         for Söhne (its UI face). Loaded as webfonts because browsers with
         fingerprinting protection, Brave among them, refuse the local Charter. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Charis+SIL:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a href="#/" id="brand">renacentista<span>.dev</span></a>
        <div class="topbar-right">
          <span id="navChip" class="nav-chip" hidden></span>
          <span id="status"></span>
          <button id="cancelBtn" class="btn-ghost" hidden>Cancelar</button>
          <button id="saveBtn" class="btn-ghost" hidden>Guardar</button>
          <button id="publishBtn" class="btn-green" hidden>Publicar…</button>
          <a href="#/novela-nueva" id="newNovelBtn" class="btn-ghost">Nueva novela</a>
          <a href="#/new" id="newBtn" class="btn-green">Nueva entrega</a>
        </div>
      </div>
    </header>

    <main id="listView">
      <h1 class="list-title">Novelas</h1>
      <div id="novelList"></div>
      <h1 class="list-title spaced">Entregas</h1>
      <div id="storyList"></div>
    </main>

    <main id="novelView" hidden>
      <h1 class="list-title" id="novelHeading">Nueva novela</h1>
      <form id="novelForm" class="novel-form" autocomplete="off">
        <label>Título
          <input id="nvTitle" type="text" maxlength="60" required />
        </label>
        <label>Carpeta y URL
          <input id="nvSlug" type="text" maxlength="50" spellcheck="false" required />
          <span class="hint" id="nvPath"></span>
        </label>
        <label>Línea de gancho
          <input id="nvTagline" type="text" maxlength="90" required />
        </label>
        <label>Sinopsis
          <textarea id="nvSynopsis" rows="4" maxlength="400" required></textarea>
        </label>
        <div class="row3">
          <label>Estado
            <select id="nvStatus"></select>
          </label>
          <label>Fósforo
            <select id="nvPhosphor"></select>
          </label>
          <label>Sigilo
            <input id="nvSigil" type="text" maxlength="4" required />
          </label>
        </div>
        <div class="row2">
          <label>Géneros (separados por coma)
            <input id="nvGenre" type="text" />
          </label>
          <label>Primera entrega
            <input id="nvDate" type="date" />
          </label>
        </div>
        <label>Nota de la obra (opcional)
          <textarea id="nvBody" rows="3"></textarea>
        </label>
        <label class="check">
          <input id="nvDraft" type="checkbox" />
          <span>Borrador (la obra no aparece en el sitio)</span>
        </label>
        <button type="submit" class="btn-green wide">Guardar novela</button>
      </form>
    </main>

    <main id="writeView" hidden>
      <textarea id="titleInput" placeholder="Título de la entrega" rows="1" maxlength="80"></textarea>
      <div id="editorMount"></div>
    </main>

    <div id="bubbleMenu" class="bubble-menu" hidden>
      <button data-cmd="bold"><b>B</b></button>
      <button data-cmd="italic"><i>i</i></button>
      <button data-cmd="link">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
      </button>
      <span class="sep"></span>
      <button data-cmd="h1" class="glyph-t">T</button>
      <button data-cmd="h2" class="glyph-t small">T</button>
      <button data-cmd="quote">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M9.6 5C6 7 4 9.9 4 13.4 4 16.4 5.8 18 8 18c1.9 0 3.4-1.5 3.4-3.4 0-1.8-1.3-3.2-3-3.2-.3 0-.7 0-.8.1.3-1.8 1.8-3.8 3.5-4.8L9.6 5zm9 0c-3.6 2-5.6 4.9-5.6 8.4 0 3 1.8 4.6 4 4.6 1.9 0 3.4-1.5 3.4-3.4 0-1.8-1.3-3.2-3-3.2-.3 0-.7 0-.8.1.3-1.8 1.8-3.8 3.5-4.8L18.6 5z"/></svg>
      </button>
    </div>

    <div id="floatingMenu" class="floating-menu" hidden>
      <button id="plusBtn" title="Insertar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <div class="plus-actions">
        <button data-insert="image" title="Imagen">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </button>
        <button data-insert="code" title="Bloque de código">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg>
        </button>
        <button data-insert="hr" title="Separador">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
        </button>
      </div>
    </div>

    <div id="panelOverlay" hidden></div>
    <aside id="publishPanel" hidden>
      <h2>Publicar entrega</h2>
      <label>Novela
        <select id="fldNovel"></select>
      </label>
      <label>Dirección
        <input id="fldSlug" type="text" maxlength="50" spellcheck="false" />
        <span class="hint" id="hintUrl"></span>
      </label>
      <label>Fecha de publicación
        <input id="fldDate" type="date" />
        <span class="hint">Ordena la obra: la entrega se numera por esta fecha.</span>
      </label>
      <label class="check">
        <input id="fldDraft" type="checkbox" />
        <span>Borrador (no se publica en el sitio)</span>
      </label>
      <p class="hint" id="hintReading">Tiempo de lectura: <span id="fldReading">–</span> min</p>
      <button id="panelSaveBtn" class="btn-green wide">Guardar</button>
    </aside>

    <input type="file" id="imageFile" accept=".png,.jpg,.jpeg,.webp,.gif,.svg" hidden />
    <div id="toast" hidden></div>

    <script>
      import { Editor } from '@tiptap/core';
      import StarterKit from '@tiptap/starter-kit';
      import Link from '@tiptap/extension-link';
      import Image from '@tiptap/extension-image';
      import Placeholder from '@tiptap/extension-placeholder';
      import BubbleMenu from '@tiptap/extension-bubble-menu';
      import FloatingMenu from '@tiptap/extension-floating-menu';
      import { Markdown } from 'tiptap-markdown';

      const $ = (id) => document.getElementById(id);

      // tippy detaches these from the DOM when the editor is destroyed, so hold
      // on to the nodes instead of looking them up by id later.
      const bubbleEl = $('bubbleMenu');
      const floatingEl = $('floatingMenu');
      const api = (p, opts) =>
        fetch(`/_editor/api${p}`, opts).then(async (r) => {
          const data = await r.json();
          if (!r.ok) throw new Error(data.error ?? r.statusText);
          return data;
        });

      let posts = [];
      let novels = [];
      let novelOptions = { status: [], phosphors: [] };
      let collectionsMeta = {}; // { <novela>: { nav, menu, sub, full, maxTitle }, ... }
      let DEFAULT_COLLECTION = '';
      let current = null; // { fm, isNew, collection }
      let dirty = false;
      let editor = null;

      // ---------- helpers ----------
      const todayISO = () => {
        const d = new Date();
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      };
      const kebab = (s) =>
        s.normalize('NFD').replace(/[̀-ͯ]/g, '')
          .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      const readingTime = (md) => Math.max(1, Math.round(md.trim().split(/\s+/).length / 200));
      const fmtDate = (iso) =>
        new Date(`${iso}T12:00:00`).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });

      function toast(msg, isError = false) {
        const el = $('toast');
        el.textContent = msg;
        el.classList.toggle('error', isError);
        el.hidden = false;
        clearTimeout(toast._t);
        toast._t = setTimeout(() => (el.hidden = true), 2600);
      }

      function setDirty(v) {
        dirty = v;
        $('status').textContent = current ? (v ? 'Sin guardar' : 'Guardado') : '';
        $('status').classList.toggle('dirty', v);
      }

      // ---------- editor ----------
      function createEditor(markdown) {
        editor?.destroy();
        for (const el of [bubbleEl, floatingEl]) {
          if (!el.isConnected) document.body.append(el);
          el.hidden = false;
        }
        editor = new Editor({
          element: $('editorMount'),
          extensions: [
            StarterKit.configure({ heading: { levels: [1, 2, 3] } }),
            Link.configure({ openOnClick: false }),
            Image,
            Placeholder.configure({ placeholder: 'Escribe la entrega…' }),
            BubbleMenu.configure({ element: bubbleEl, tippyOptions: { duration: 120 } }),
            FloatingMenu.configure({ element: floatingEl, tippyOptions: { duration: 120, placement: 'left' } }),
            Markdown.configure({ html: true, breaks: false }),
          ],
          content: markdown,
          onUpdate: () => setDirty(true),
          onTransaction: updateBubbleState,
        });
      }

      function updateBubbleState() {
        if (!editor) return;
        const map = {
          bold: editor.isActive('bold'),
          italic: editor.isActive('italic'),
          link: editor.isActive('link'),
          h1: editor.isActive('heading', { level: 1 }),
          h2: editor.isActive('heading', { level: 2 }),
          quote: editor.isActive('blockquote'),
        };
        for (const btn of bubbleEl.querySelectorAll('[data-cmd]'))
          btn.classList.toggle('active', !!map[btn.dataset.cmd]);
      }

      bubbleEl.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-cmd]');
        if (!btn || !editor) return;
        const chain = editor.chain().focus();
        switch (btn.dataset.cmd) {
          case 'bold': chain.toggleBold().run(); break;
          case 'italic': chain.toggleItalic().run(); break;
          case 'h1': chain.toggleHeading({ level: 1 }).run(); break;
          case 'h2': chain.toggleHeading({ level: 2 }).run(); break;
          case 'quote': chain.toggleBlockquote().run(); break;
          case 'link': {
            const prev = editor.getAttributes('link').href ?? '';
            const url = window.prompt('URL del enlace (vacío para quitar):', prev);
            if (url === null) break;
            if (url === '') chain.extendMarkRange('link').unsetLink().run();
            else chain.extendMarkRange('link').setLink({ href: url }).run();
            break;
          }
        }
      });

      $('plusBtn').addEventListener('click', () => floatingEl.classList.toggle('open'));
      floatingEl.querySelector('.plus-actions').addEventListener('click', (e) => {
        const btn = e.target.closest('[data-insert]');
        if (!btn || !editor) return;
        floatingEl.classList.remove('open');
        if (btn.dataset.insert === 'code') editor.chain().focus().setCodeBlock().run();
        if (btn.dataset.insert === 'hr') editor.chain().focus().setHorizontalRule().run();
        if (btn.dataset.insert === 'image') $('imageFile').click();
      });

      $('imageFile').addEventListener('change', async () => {
        const file = $('imageFile').files[0];
        $('imageFile').value = '';
        if (!file || !editor) return;
        try {
          const dataBase64 = await new Promise((ok, ko) => {
            const r = new FileReader();
            r.onload = () => ok(r.result.split(',')[1]);
            r.onerror = ko;
            r.readAsDataURL(file);
          });
          const { url } = await api('/upload', { method: 'POST', body: JSON.stringify({ name: file.name, dataBase64 }) });
          editor.chain().focus().setImage({ src: url, alt: file.name.replace(/\.[^.]+$/, '') }).run();
          toast('Imagen insertada');
        } catch (err) {
          toast(`Error al subir: ${err.message}`, true);
        }
      });

      // ---------- title ----------
      const titleInput = $('titleInput');
      const growTitle = () => {
        titleInput.style.height = 'auto';
        titleInput.style.height = `${titleInput.scrollHeight}px`;
      };
      titleInput.addEventListener('input', () => {
        growTitle();
        setDirty(true);
        if (current?.isNew) syncNewSlug();
      });
      titleInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          editor?.commands.focus('start');
        }
      });

      function syncNewSlug() {
        current.fm.slug = kebab(titleInput.value).slice(0, 50).replace(/-+$/, '');
        $('fldSlug').value = current.fm.slug;
        syncUrlHint();
      }

      // Una entrega pertenece a una obra y nada mas: el destino es la novela.
      function applySection(collection) {
        current.collection = collection;
        const meta = collectionsMeta[collection];
        $('navChip').textContent = meta.nav;
        titleInput.maxLength = meta.maxTitle;
        if (current.isNew) syncNewSlug();
        syncUrlHint();
      }

      function syncUrlHint() {
        const slug = $('fldSlug').value || '<dirección>';
        $('hintUrl').textContent = `renacentista.dev/novelas/${current?.collection ?? ''}/${slug}`;
      }

      function renderNovels(collection) {
        $('fldNovel').innerHTML = Object.keys(collectionsMeta)
          .map((c) => `<option value="${c}">${collectionsMeta[c].sub ?? c}</option>`).join('');
        $('fldNovel').value = collection;
      }

      // ---------- publish panel ----------
      function openPanel() {
        const fm = current.fm;
        renderNovels(current.collection);
        $('fldSlug').value = fm.slug;
        $('fldSlug').disabled = !current.isNew;
        syncUrlHint();
        $('fldDate').value = fm.publishedDate;
        $('fldDraft').checked = fm.isDraft;
        $('fldReading').textContent = readingTime(editor.storage.markdown.getMarkdown());
        $('publishPanel').hidden = false;
        $('panelOverlay').hidden = false;
      }
      function closePanel() {
        $('publishPanel').hidden = true;
        $('panelOverlay').hidden = true;
      }
      $('panelOverlay').addEventListener('click', closePanel);
      $('publishBtn').addEventListener('click', openPanel);
      $('fldNovel').addEventListener('change', () => {
        if (!current) return;
        applySection($('fldNovel').value);
        $('fldSlug').value = current.fm.slug;
        setDirty(true);
      });
      $('fldSlug').addEventListener('input', syncUrlHint);
      $('panelSaveBtn').addEventListener('click', async () => {
        const fm = current.fm;
        if (current.isNew) fm.slug = $('fldSlug').value.trim();
        fm.publishedDate = $('fldDate').value;
        fm.isDraft = $('fldDraft').checked;
        setDirty(true);
        if (await save()) closePanel();
      });

      // ---------- save ----------
      function rememberNovel(collection) {
        try { localStorage.setItem('editor:last-novel', collection); } catch {}
      }

      async function save() {
        if (!current || !editor) return false;
        const body = editor.storage.markdown.getMarkdown();
        const fm = { ...current.fm, title: titleInput.value.trim() };
        if (!fm.title) { toast('Ponle un título primero', true); return false; }
        try {
          await api('/posts', { method: 'POST', body: JSON.stringify({ collection: current.collection, fromCollection: current.saved, frontmatter: fm, body }) });
          const moved = current.saved != null && current.saved !== current.collection;
          current.fm = fm;
          current.isNew = false;
          current.saved = current.collection;
          rememberNovel(current.collection);
          history.replaceState(null, '', `#/edit/${current.collection}/${fm.slug}`);
          setDirty(false);
          toast(moved ? `Movido a ${collectionsMeta[current.collection].nav}` : `Guardado en ${fm.slug}.md`);
          return true;
        } catch (err) {
          toast(`Error al guardar: ${err.message}`, true);
          return false;
        }
      }
      $('saveBtn').addEventListener('click', save);
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 's') {
          e.preventDefault();
          if (current) save();
        }
      });
      window.addEventListener('beforeunload', (e) => {
        if (dirty) e.preventDefault();
      });

      // ---------- views ----------
      function showList() {
        current = null;
        editor?.destroy();
        editor = null;
        setDirty(false);
        $('writeView').hidden = true;
        // tippy leaves these parked in the body after destroy; drop them so they
        // cannot show up under the list. createEditor re-attaches them.
        bubbleEl.remove();
        floatingEl.remove();
        $('saveBtn').hidden = true;
        $('publishBtn').hidden = true;
        $('cancelBtn').hidden = true;
        $('navChip').hidden = true;
        $('newBtn').hidden = false;
        $('newNovelBtn').hidden = false;
        $('novelView').hidden = true;
        $('listView').hidden = false;
        $('novelList').innerHTML = novels.map((n) => `
          <a class="story" href="#/novela/${n.slug}">
            <h2>${n.frontmatter.title}</h2>
            <p class="meta">
              <span class="navtag">/novelas/${n.slug}</span>
              ${n.frontmatter.status} · ${n.installments} ${n.installments === 1 ? 'entrega' : 'entregas'} · fósforo ${n.frontmatter.phosphor}
              ${n.frontmatter.isDraft ? '<span class="pill">Borrador</span>' : ''}
            </p>
          </a>`).join('') || '<p class="meta">Sin novelas todavía. Empieza por «Nueva novela».</p>';
        const rows = posts.map((p) => `
          <a class="story" href="#/edit/${p.collection}/${p.slug}">
            <h2>${p.title}</h2>
            <p class="meta">
              <span class="navtag">${p.nav}</span>
              ${fmtDate(p.publishedDate)}
              ${p.isDraft ? '<span class="pill">Borrador</span>' : ''}
            </p>
          </a>`);
        $('storyList').innerHTML = rows.join('') || '<p class="meta">Sin entregas todavía.</p>';
      }

      function showWrite(fm, body, isNew, collection) {
        // `saved` is the collection the file currently lives in on disk.
        current = { fm, isNew, collection, saved: isNew ? null : collection };
        $('listView').hidden = true;
        $('writeView').hidden = false;
        $('saveBtn').hidden = false;
        $('publishBtn').hidden = false;
        $('cancelBtn').hidden = false;
        $('navChip').hidden = false;
        $('newBtn').hidden = true;
        $('newNovelBtn').hidden = true;
        $('novelView').hidden = true;
        applySection(collection);
        titleInput.value = fm.title;
        growTitle();
        createEditor(body);
        setDirty(false);
        if (isNew) titleInput.focus();
      }

      // ---------- salir sin guardar ----------
      // Vale tanto para una entrega como para la ficha de una obra: si no se
      // escribio nada, no pregunta.
      function canLeave() {
        return !dirty || confirm('Hay cambios sin guardar. ¿Salir y perderlos?');
      }

      $('cancelBtn').addEventListener('click', () => {
        if (!canLeave()) return;
        setDirty(false);
        location.hash = '#/';
      });

      $('brand').addEventListener('click', (e) => {
        if (canLeave()) { setDirty(false); return; }
        e.preventDefault();
      });

      // ---------- novelas ----------
      function showNovel(novel) {
        current = null;
        editor?.destroy();
        editor = null;
        setDirty(false);
        $('listView').hidden = true;
        $('writeView').hidden = true;
        $('saveBtn').hidden = true;
        $('publishBtn').hidden = true;
        $('navChip').hidden = true;
        $('newBtn').hidden = true;
        $('newNovelBtn').hidden = true;
        $('cancelBtn').hidden = false;
        $('novelView').hidden = false;

        const fm = novel?.frontmatter ?? {};
        const isNew = !novel;
        $('novelHeading').textContent = isNew ? 'Nueva novela' : fm.title;
        $('nvTitle').value = fm.title ?? '';
        $('nvSlug').value = novel?.slug ?? '';
        $('nvSlug').readOnly = !isNew;
        $('nvSlug').dataset.touched = isNew ? '' : '1';
        $('nvTagline').value = fm.tagline ?? '';
        $('nvSynopsis').value = fm.synopsis ?? '';
        $('nvSigil').value = fm.sigil ?? '//';
        $('nvGenre').value = (fm.genre ?? []).join(', ');
        $('nvDate').value = fm.startedDate ?? todayISO();
        $('nvDraft').checked = Boolean(fm.isDraft);
        $('nvBody').value = novel?.body?.trim() ?? '';
        $('nvStatus').innerHTML = novelOptions.status
          .map((v) => `<option value="${v}"${v === (fm.status ?? 'en-curso') ? ' selected' : ''}>${v}</option>`).join('');
        $('nvPhosphor').innerHTML = novelOptions.phosphors
          .map((v) => `<option value="${v}"${v === (fm.phosphor ?? 'ambar') ? ' selected' : ''}>${v}</option>`).join('');
        syncNovelPath();
        if (isNew) $('nvTitle').focus();
      }

      function syncNovelPath() {
        const slug = $('nvSlug').value || '<carpeta>';
        $('nvPath').textContent = `src/content/novels/${slug}/  ·  renacentista.dev/novelas/${slug}`;
      }

      $('nvTitle').addEventListener('input', () => {
        if ($('nvSlug').dataset.touched !== '1') {
          $('nvSlug').value = kebab($('nvTitle').value).slice(0, 50).replace(/-+$/, '');
          syncNovelPath();
        }
      });
      $('nvSlug').addEventListener('input', () => {
        $('nvSlug').dataset.touched = '1';
        syncNovelPath();
      });

      $('novelForm').addEventListener('input', () => setDirty(true));

      $('novelForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          slug: $('nvSlug').value.trim(),
          frontmatter: {
            title: $('nvTitle').value.trim(),
            tagline: $('nvTagline').value.trim(),
            synopsis: $('nvSynopsis').value.trim(),
            status: $('nvStatus').value,
            phosphor: $('nvPhosphor').value,
            sigil: $('nvSigil').value.trim(),
            genre: $('nvGenre').value.split(',').map((g) => g.trim()).filter(Boolean),
            startedDate: $('nvDate').value,
            isDraft: $('nvDraft').checked,
          },
          body: $('nvBody').value,
        };
        try {
          const { created } = await api('/novels', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          await reload();
          setDirty(false);
          toast(created ? `Novela creada en src/content/novels/${payload.slug}/` : 'Ficha guardada');
          location.hash = '#/';
        } catch (err) {
          toast(err.message, true);
        }
      });

      // El listado y los selectores de entrega dependen de las obras que existan.
      async function reload() {
        const [data, novelData] = await Promise.all([api('/posts'), api('/novels')]);
        posts = data.posts;
        collectionsMeta = data.collections;
        // Se escribe una novela durante meses: la siguiente entrega casi
        // siempre va a la misma obra que la anterior.
        const last = localStorage.getItem('editor:last-novel');
        DEFAULT_COLLECTION = (last && collectionsMeta[last]) ? last : (Object.keys(collectionsMeta)[0] ?? '');
        novels = novelData.novels;
        novelOptions = { status: novelData.status, phosphors: novelData.phosphors };
      }

      async function route() {
        const hash = location.hash || '#/';
        if (hash === '#/new') {
          if (!DEFAULT_COLLECTION) {
            toast('Primero crea una novela', true);
            location.hash = '#/novela-nueva';
            return;
          }
          showWrite(
            { slug: '', title: '', publishedDate: todayISO(), isDraft: true },
            '', true, DEFAULT_COLLECTION,
          );
        } else if (hash === '#/novela-nueva') {
          showNovel(null);
        } else if (hash.startsWith('#/novela/')) {
          const slug = hash.slice('#/novela/'.length);
          const novel = novels.find((n) => n.slug === slug);
          if (!novel) { toast('Novela no encontrada', true); location.hash = '#/'; return; }
          showNovel(novel);
        } else if (hash.startsWith('#/edit/')) {
          const [collection, slug] = hash.slice('#/edit/'.length).split('/');
          try {
            const { frontmatter, body } = await api(`/posts/${collection}/${slug}`);
            showWrite(frontmatter, body, false, collection);
          } catch (err) {
            toast(err.message, true);
            location.hash = '#/';
          }
        } else {
          await reload();
          showList();
        }
      }

      window.addEventListener('hashchange', route);

      // Surface failures that would otherwise leave the UI half-rendered.
      window.addEventListener('error', (e) => toast(e.message, true));
      window.addEventListener('unhandledrejection', (e) => toast(e.reason?.message ?? String(e.reason), true));

      (async () => {
        // La obra por defecto es la primera que exista: el editor no conoce
        // ninguna novela de antemano.
        await reload();
        route();
      })();
    </script>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --serif: charter, 'Charis SIL', Georgia, 'Times New Roman', serif;
        --sans: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        --ink: #242424;
        --gray: #6b6b6b;
        --green: #1a8917;
        --line: #f2f2f2;
      }
      html, body { background: #fff; color: var(--ink); font-family: var(--sans); }

      /* ---- topbar ---- */
      .topbar { position: sticky; top: 0; background: #fff; border-bottom: 1px solid var(--line); z-index: 20; }
      .topbar-inner { max-width: 1032px; margin: 0 auto; height: 57px; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; }
      #brand { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--ink); text-decoration: none; }
      #brand span { color: var(--gray); font-weight: 400; }
      .topbar-right { display: flex; align-items: center; gap: 16px; }
      #status { font-size: 13px; color: var(--gray); }
      #status.dirty { color: #b56a00; }
      .btn-green { background: var(--green); color: #fff; border: none; border-radius: 99px; padding: 7px 16px; font-size: 14px; cursor: pointer; text-decoration: none; font-family: var(--sans); }
      .btn-green:hover { background: #156d12; }
      .btn-green.wide { width: 100%; padding: 10px; margin-top: 24px; font-size: 15px; }
      .btn-ghost { background: none; border: 1px solid #d9d9d9; border-radius: 99px; padding: 6px 15px; font-size: 14px; color: var(--ink); cursor: pointer; }
      .btn-ghost:hover { border-color: var(--ink); }

      /* ---- list ---- */
      #listView { max-width: 728px; margin: 0 auto; padding: 48px 24px 96px; }
      .list-title { font-family: var(--serif); font-size: 42px; font-weight: 700; margin-bottom: 40px; }
      .story { display: block; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
      .story h2 { font-family: var(--serif); font-size: 22px; font-weight: 700; margin-bottom: 6px; }
      .story:hover h2 { color: #000; text-decoration: underline; }
      .meta { font-size: 13.5px; color: var(--gray); }
      .pill { display: inline-block; margin-left: 8px; padding: 1px 9px; border: 1px solid #d9a900; color: #8a6d00; border-radius: 99px; font-size: 12px; }
      .navtag { display: inline-block; margin-right: 8px; padding: 1px 9px; background: var(--line); color: var(--gray); border-radius: 4px; font-size: 12px; font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .nav-chip { padding: 2px 10px; background: var(--line); color: var(--gray); border-radius: 4px; font-size: 13px; font-family: 'JetBrains Mono', ui-monospace, monospace; }

      /* ---- write view ---- */
      #writeView { max-width: 740px; margin: 0 auto; padding: 48px 24px 40vh; }
      #titleInput {
        width: 100%; border: none; outline: none; resize: none; overflow: hidden;
        font-family: var(--serif); font-size: 42px; line-height: 1.15; font-weight: 700; color: var(--ink);
      }
      #titleInput::placeholder { color: #b3b3b1; }

      /* ---- prose (Medium look) ---- */
      .ProseMirror { outline: none; margin-top: 14px; font-family: var(--serif); font-size: 21px; line-height: 1.58; letter-spacing: -0.003em; }
      .ProseMirror > * + * { margin-top: 1.35em; }
      .ProseMirror h1 { font-size: 32px; line-height: 1.22; font-weight: 700; margin-top: 1.6em; }
      .ProseMirror h2 { font-size: 26px; line-height: 1.25; font-weight: 700; margin-top: 1.5em; }
      .ProseMirror h3 { font-size: 22px; font-weight: 700; }
      .ProseMirror blockquote { border-left: 3px solid var(--ink); padding-left: 23px; margin-left: -26px; font-style: italic; }
      .ProseMirror a { color: inherit; text-decoration: underline; }
      .ProseMirror code { background: #f2f2f2; font-size: 0.78em; padding: 2px 5px; border-radius: 3px; font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .ProseMirror pre { background: #f7f7f7; border-radius: 5px; padding: 20px 24px; font-size: 15px; line-height: 1.5; overflow-x: auto; }
      .ProseMirror pre code { background: none; padding: 0; font-size: inherit; }
      .ProseMirror ul, .ProseMirror ol { padding-left: 28px; }
      .ProseMirror li { margin-top: 0.6em; }
      .ProseMirror img { max-width: 100%; display: block; margin: 0 auto; }
      .ProseMirror img.ProseMirror-selectednode { outline: 3px solid #b3d3ff; }
      .ProseMirror hr { border: none; text-align: center; margin: 2.4em 0; }
      .ProseMirror hr::before { content: '· · ·'; font-size: 26px; letter-spacing: 14px; color: var(--ink); }
      .ProseMirror p.is-editor-empty:first-child::before {
        content: attr(data-placeholder); float: left; height: 0; pointer-events: none; color: #b3b3b1;
      }

      /* ---- bubble menu ---- */
      .bubble-menu {
        display: flex; align-items: center; background: #262625; border-radius: 6px; padding: 0 4px;
        box-shadow: 0 2px 10px rgba(0,0,0,.25);
      }
      /* the display rules above outrank the UA style for [hidden] */
      .bubble-menu[hidden], .floating-menu[hidden] { display: none; }
      .bubble-menu button {
        background: none; border: none; color: #fff; width: 40px; height: 44px; cursor: pointer;
        font-family: var(--serif); font-size: 19px; display: flex; align-items: center; justify-content: center;
      }
      .bubble-menu button.active { color: #7cd97a; }
      .bubble-menu .glyph-t { font-size: 22px; }
      .bubble-menu .glyph-t.small { font-size: 16px; }
      .bubble-menu .sep { width: 1px; height: 24px; background: rgba(255,255,255,.25); margin: 0 4px; }

      /* ---- floating (+) menu ---- */
      .floating-menu { display: flex; align-items: center; gap: 10px; margin-left: -14px; }
      .floating-menu button {
        width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--gray); background: #fff;
        color: var(--gray); cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: transform .15s;
      }
      .floating-menu.open #plusBtn { transform: rotate(45deg); }
      .plus-actions { display: none; gap: 10px; }
      .floating-menu.open .plus-actions { display: flex; }
      .plus-actions button { border-color: var(--green); color: var(--green); }

      /* ---- publish panel ---- */
      #panelOverlay { position: fixed; inset: 0; background: rgba(255,255,255,.7); z-index: 30; }
      #publishPanel {
        position: fixed; top: 0; right: 0; bottom: 0; width: 380px; max-width: 92vw; background: #fff;
        box-shadow: -4px 0 24px rgba(0,0,0,.12); z-index: 31; padding: 40px 32px;
      }
      #publishPanel h2 { font-family: var(--serif); font-size: 24px; margin-bottom: 28px; }
      /* ---- ficha de obra ---- */
      #novelView { max-width: 728px; margin: 0 auto; padding: 48px 24px 96px; }
      .list-title.spaced { margin-top: 56px; }
      .novel-form label { display: block; font-size: 13px; color: var(--gray); margin-bottom: 18px; }
      .novel-form input[type=text], .novel-form input[type=date], .novel-form select, .novel-form textarea {
        display: block; width: 100%; margin-top: 6px; padding: 8px 10px; font-size: 14px;
        border: 1px solid #d9d9d9; border-radius: 4px; color: var(--ink); background: #fff; font-family: var(--sans);
      }
      .novel-form textarea { resize: vertical; line-height: 1.5; }
      .novel-form .row2, .novel-form .row3 { display: grid; gap: 16px; }
      .novel-form .row2 { grid-template-columns: 2fr 1fr; }
      .novel-form .row3 { grid-template-columns: 1fr 1fr 1fr; }
      .novel-form .check { display: flex; align-items: center; gap: 9px; font-size: 14px; color: var(--ink); }
      .novel-form .check input { width: auto; margin: 0; }
      .novel-form .hint { display: block; margin-top: 6px; font-size: 12px; color: var(--gray); font-family: 'JetBrains Mono', ui-monospace, monospace; }

      #publishPanel label { display: block; font-size: 13px; color: var(--gray); margin-bottom: 18px; }
      #publishPanel input[type="text"], #publishPanel input[type="date"], #publishPanel select {
        display: block; width: 100%; margin-top: 6px; padding: 8px 10px; font-size: 14px;
        border: 1px solid #d9d9d9; border-radius: 4px; color: var(--ink); background: #fff; font-family: var(--sans);
      }
      #publishPanel input:disabled { background: var(--line); color: var(--gray); }
      #publishPanel .check { display: flex; align-items: center; gap: 9px; font-size: 14px; color: var(--ink); }
      #publishPanel .hint { display: block; margin-top: 6px; font-size: 12px; color: var(--gray); }
      #publishPanel #hintUrl { font-family: 'JetBrains Mono', ui-monospace, monospace; word-break: break-all; }

      /* ---- toast ---- */
      #toast {
        position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%);
        background: #262625; color: #fff; padding: 10px 20px; border-radius: 6px; font-size: 14px; z-index: 40;
      }
      #toast.error { background: #9d1f1f; }
    </style>
  </body>
</html>
