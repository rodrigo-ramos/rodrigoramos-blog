---
// components
import Text from "../elements/Text.astro";
import NavBar from "./NavBar.astro";

// content
import { getNovels, getTimeline } from "../../utils/novels";
const novels = await getNovels();
const timeline = await getTimeline();

const obras = novels.length === 1 ? "1 obra" : `${novels.length} obras`;
const entregas = timeline.length === 1 ? "1 entrega" : `${timeline.length} entregas`;

const {
    tagline = "ficción por entregas",
    author = "escribe El Renacentista"
} = Astro.props;
---

<header class="flex flex-col gap-24 md:pt-56 pt-16 bg-base-950 md:sticky md:top-0 z-50">
    <div class="md:px-32 px-16 flex md:flex-row flex-col gap-16 justify-between md:items-end items-center">
        <div class="flex flex-col md:text-left text-center">
            <Text variant={'normal'} class="text-base-700">// {tagline}</Text>
            <a href="/" class="hover:opacity-80">
                <Text variant={'xl'} class="text-phosphor glow-phosphor">renacentista.dev</Text>
            </a>
            <Text variant={'sm'} class="text-base-600">{author}</Text>
        </div>
        <div class="bg-base-900 drop-shadow-md p-8">
            <Text variant={'sm'} class="text-base-200">{obras} · {entregas}</Text>
        </div>
    </div>
    <NavBar />
</header>
