---
const pathname = Astro.url.pathname;

// components
import Link from "../elements/Link.astro"

// content
import { getNovels, slugOf } from "../../utils/novels";
const novels = await getNovels();

// Las obras cuelgan de /novelas: entrar a leer nunca cuesta mas de dos clics.
const nav = [
    { title: "/inicio", href: "/" },
    {
        title: "/novelas",
        href: "/novelas",
        children: novels.map((novel) => ({
            title: novel.data.title,
            href: `/novelas/${slugOf(novel)}`
        }))
    },
    { title: "/acerca", href: "/acerca" },
    { title: "/buscar", href: "/buscar" },
]
---

<nav class="bg-base-900 flex flex-row flex-wrap sticky top-0 z-20">
    {
        nav.map((navLink) => {
            const isActive = navLink.href === "/" ? pathname === "/" : pathname.startsWith(navLink.href);
            const activeClass = isActive ? "bg-base-950 border-t-2 border-base-900" : "";

            if (!navLink.children?.length) return (
                <Link
                    variant={'nav'}
                    href={navLink.href}
                    text={navLink.title}
                    aria-current={isActive ? "page" : undefined}
                    class={activeClass}
                />
            );

            // Submenu opens on hover and on keyboard focus, no JS involved.
            return (
                <div class="relative group flex">
                    <Link
                        variant={'nav'}
                        href={navLink.href}
                        text={navLink.title}
                        aria-current={isActive ? "page" : undefined}
                        aria-haspopup="true"
                        class:list={["flex items-center", activeClass]}
                    />
                    <div class="absolute left-0 top-full z-30 hidden group-hover:flex group-focus-within:flex flex-col min-w-full whitespace-nowrap">
                        {
                            navLink.children.map((child) => (
                                <Link
                                    variant={'nav'}
                                    href={child.href}
                                    text={child.title}
                                    aria-current={pathname.startsWith(child.href) ? "page" : undefined}
                                    class={pathname.startsWith(child.href) ? "bg-base-950" : ""}
                                />
                            ))
                        }
                    </div>
                </div>
            );
        })
    }
</nav>
